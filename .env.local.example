# Copy to .env.local and fill in.

# Optional: npm run login can autofill WatIAM credentials before waiting for
# manual Duo approval. A bare username is submitted as username@uwaterloo.ca.
# You can also set the full username@uwaterloo.ca value yourself.
WATIAM_USERNAME=
WATIAM_PASSWORD=

# Optional: directory for cached outline.uwaterloo.ca text/HTML snapshots.
# Defaults to ./cache/outlines.
LEARN_OUTLINE_CACHE_DIR=

# Google Drive API access for searching the shared past-assessments folder.
# For a public/shared folder, create an API key with the Google Drive API
# enabled. For private folders, provide a short-lived OAuth access token with
# the https://www.googleapis.com/auth/drive.readonly scope instead and share
# the folder with that Google account.
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_ACCESS_TOKEN=

# Comma-separated folder IDs to search recursively. Defaults to the Waterloo
# shared folder linked in the README.
GOOGLE_DRIVE_FOLDER_IDS=1yYicgQ3n8z-DutH3-kVtatmAcxpHK3cf
